pkgname=vitasdk-transaction-fixture
pkgver=2.0
pkgrel=1
pkgdesc="VitaSDK package transaction test fixture"
arch=('vita')
url="https://vitasdk.org/"
license=('MIT')
options=('!strip' '!docs' '!libtool' '!staticlibs' '!emptydirs' '!zipman' '!purge' '!debug')

package() {
	local fixture_dir="$pkgdir$VITASDK/arm-vita-eabi/share/vitasdk-transaction-test"
	install -dm755 "$fixture_dir"
	printf '2.0\n' > "$fixture_dir/version.txt"
	printf 'upgraded\n' > "$fixture_dir/upgrade-marker.txt"
}
